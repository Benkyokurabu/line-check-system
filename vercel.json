{
  "crons": [
    {
      "path": "/api/ai/route-messages?limit=20",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/notifications/teams/send?limit=20",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/notion-roster-sync",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/line-identity-candidates",
      "schedule": "0 21 * * *"
    }
  ],
  "env": {
    "STAFF_AUTH_ENABLED": "true",
    "STAFF_AUTH_ORIGIN": "https://line-check-system.vercel.app"
  }
}
